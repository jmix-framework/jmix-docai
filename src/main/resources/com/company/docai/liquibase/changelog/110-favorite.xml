<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="com/company/docai/liquibase/changelog/110-favorite.xml">
    <changeSet id="1" author="jmix-docai" context="!cuba">
        <createTable tableName="FAVORITE">
            <column name="ID" type="${uuid.type}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_FAVORITE"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="USER_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="FOLDER_ID" type="${uuid.type}"/>
            <column name="DOCUMENT_ID" type="${uuid.type}"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="jmix-docai" context="!cuba">
        <addUniqueConstraint tableName="FAVORITE" columnNames="USER_ID, FOLDER_ID"
                             constraintName="UK_FAVORITE_FOLDER"/>
        <addUniqueConstraint tableName="FAVORITE" columnNames="USER_ID, DOCUMENT_ID"
                             constraintName="UK_FAVORITE_DOCUMENT"/>
        <createIndex indexName="IDX_FAVORITE_FOLDER" tableName="FAVORITE">
            <column name="FOLDER_ID"/>
        </createIndex>
        <createIndex indexName="IDX_FAVORITE_DOCUMENT" tableName="FAVORITE">
            <column name="DOCUMENT_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="FAVORITE" baseColumnNames="USER_ID"
                                 referencedTableName="USER_" referencedColumnNames="ID"
                                 constraintName="FK_FAVORITE_ON_USER" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="FAVORITE" baseColumnNames="FOLDER_ID"
                                 referencedTableName="FOLDER" referencedColumnNames="ID"
                                 constraintName="FK_FAVORITE_ON_FOLDER"/>
        <addForeignKeyConstraint baseTableName="FAVORITE" baseColumnNames="DOCUMENT_ID"
                                 referencedTableName="DOCUMENT" referencedColumnNames="ID"
                                 constraintName="FK_FAVORITE_ON_DOCUMENT"/>
    </changeSet>
</databaseChangeLog>
