<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <data readOnly="true">
        <instance id="commentDc" class="com.company.docai.model.document.DocumentComment"/>
    </data>
    <content>
        <hbox id="commentRoot" classNames="document-comment" width="100%" padding="false">
            <avatar id="authorAvatar"/>
            <vbox id="commentBody" classNames="document-comment-body" padding="false" spacing="false">
                <hbox id="commentHeader" width="100%" alignItems="CENTER" padding="false" wrap="true">
                    <span id="authorName" classNames="document-comment-author"/>
                    <span id="writtenTime" classNames="document-comment-meta"/>
                    <span id="editedMark" classNames="document-comment-meta" text="msg://commentEdited"
                          visible="false"/>
                    <hbox id="commentActions" classNames="document-comment-actions" padding="false"
                          spacing="false">
                        <button id="editCommentButton" icon="EDIT" themeNames="tertiary"
                                ariaLabel="msg://editCommentButton.tooltip">
                            <tooltip text="msg://editCommentButton.tooltip"/>
                        </button>
                        <button id="deleteCommentButton" icon="TRASH" themeNames="tertiary"
                                ariaLabel="msg://deleteCommentButton.tooltip">
                            <tooltip text="msg://deleteCommentButton.tooltip"/>
                        </button>
                    </hbox>
                </hbox>
                <span id="commentText" classNames="document-comment-text" dataContainer="commentDc"
                      property="text"/>
                <vbox id="editPanel" width="100%" padding="false" visible="false">
                    <textArea id="editCommentField" width="100%" minRows="2" maxRows="8" valueChangeMode="EAGER"
                              trimEnabled="false"/>
                    <hbox id="editActions" width="100%" justifyContent="END" alignItems="CENTER">
                        <span id="editCommentLength" classNames="document-comment-meta"/>
                        <button id="cancelCommentButton" text="msg://cancelCommentButton.text"/>
                        <button id="saveCommentButton" text="msg://saveCommentButton.text" themeNames="primary"/>
                    </hbox>
                </vbox>
            </vbox>
        </hbox>
    </content>
</fragment>
