<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://documentStatusDetailView.title"
      focusComponent="nameField">
    <data>
        <instance id="statusDc" class="com.company.docai.model.document.DocumentStatus">
            <fetchPlan extends="_base">
                <property name="targets" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="statusDc">
            <textField id="nameField" property="name"/>
            <formItem id="colorItem" label="msg://colorItem.label">
                <!-- the palette swatches go before the custom one, from the controller -->
                <div id="swatches" classNames="status-swatches">
                    <input id="customColorInput" type="color" classNames="status-swatch"
                           ariaLabel="msg://customColorInput.ariaLabel"/>
                </div>
            </formItem>
            <!-- the place changes in the list, by a drag or the buttons; the dialog only shows it -->
            <integerField id="positionField" property="position" readOnly="true" required="false"/>
            <!-- false is a value of these flags, not an empty field -->
            <checkbox id="initialField" property="initial" required="false"/>
            <checkbox id="lockedField" property="locked" required="false"/>
            <checkbox id="anyTargetField" property="anyTarget" required="false"/>
            <multiSelectComboBox id="targetsField" property="targets"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
