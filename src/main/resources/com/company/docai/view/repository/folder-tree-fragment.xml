<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <data readOnly="true">
        <collection id="foldersDc" class="com.company.docai.model.folder.Folder">
            <loader id="foldersDl"/>
        </collection>
    </data>
    <facets>
        <fragmentSettings auto="true"/>
    </facets>
    <content>
        <vbox id="folderTreeRoot" classNames="folder-tree" width="100%" height="100%"
              minWidth="12em" padding="false" expand="treeFrame">
            <!-- the field and the folder buttons share one row, so the tree in the menu starts right under them: one
                 button creates a folder, the other lists the actions on the chosen folder -->
            <hbox id="folderToolbar" width="100%" alignItems="CENTER" expand="folderFilterField">
                <textField id="folderFilterField" clearButtonVisible="true" valueChangeMode="LAZY"
                           placeholder="msg://com.company.docai.view.folder/folderFilterField.placeholder"
                           ariaLabel="msg://com.company.docai.view.folder/folderFilterField.placeholder">
                    <prefix>
                        <icon icon="SEARCH"/>
                    </prefix>
                </textField>
                <button id="createFolderButton" action="foldersTree.createFolderAction" text=""/>
                <dropdownButton id="folderActionsButton" icon="ELLIPSIS_H" dropdownIndicatorVisible="false"
                                title="msg://folderActionsButton.title">
                    <items>
                        <actionItem id="renameFolderItem" ref="foldersTree.renameFolderAction"/>
                        <actionItem id="moveFolderItem" ref="foldersTree.moveFolderAction"/>
                        <actionItem id="accessFolderItem" ref="foldersTree.accessFolderAction"/>
                        <actionItem id="favoriteFolderItem" ref="foldersTree.favoriteAction"/>
                        <actionItem id="deleteFolderItem" ref="foldersTree.deleteFolderAction"/>
                    </items>
                </dropdownButton>
            </hbox>
            <vbox id="treeFrame" classNames="folder-tree-frame" width="100%" padding="false" spacing="false"
                  expand="foldersTree">
                <!-- the section opens and closes here, so that the settings of the tree keep its state: a fragment
                     inside a fragment has no id for settings of its own -->
                <details id="favoritesDetails" classNames="favorites" opened="true" width="100%"
                         summaryText="msg://com.company.docai.view.favorite/favoritesDetails.summaryText">
                    <fragment id="favorites" class="com.company.docai.view.favorite.FavoritesFragment"/>
                </details>
                <!-- all the rows show, so the menu scrolls as a whole rather than the tree inside it -->
                <treeDataGrid id="foldersTree" dataContainer="foldersDc" hierarchyProperty="parent"
                              rowsDraggable="true" allRowsVisible="true" width="100%" themeNames="no-border">
                    <actions showInContextMenuEnabled="false">
                        <!-- the button that creates a folder takes its hint from the description, as it shows only
                             the icon -->
                        <action id="createFolderAction" text="msg://createFolderAction.text"
                                description="msg://createFolderAction.text" icon="FOLDER_ADD"/>
                        <action id="renameFolderAction" type="list_itemTracking"
                                text="msg://renameFolderAction.text" icon="PENCIL"/>
                        <action id="moveFolderAction" type="list_itemTracking"
                                text="msg://moveFolderAction.text" icon="ARROW_RIGHT"/>
                        <action id="accessFolderAction" type="docai_accessList"
                                text="msg://accessAction.text" icon="KEY"/>
                        <action id="favoriteAction" type="docai_favoriteList"/>
                        <action id="deleteFolderAction" type="list_itemTracking" actionVariant="DANGER"
                                text="msg://deleteFolderAction.text" icon="TRASH"/>
                    </actions>
                    <contextMenu>
                        <item id="createFolderContextItem" action="foldersTree.createFolderAction"
                              classNames="main-menu-item"/>
                        <item id="renameFolderContextItem" action="foldersTree.renameFolderAction"/>
                        <item id="moveFolderContextItem" action="foldersTree.moveFolderAction"/>
                        <item id="accessFolderContextItem" action="foldersTree.accessFolderAction"/>
                        <item id="favoriteFolderContextItem" action="foldersTree.favoriteAction"/>
                        <item id="deleteFolderContextItem" action="foldersTree.deleteFolderAction"
                              classNames="danger-menu-item"/>
                    </contextMenu>
                    <columns>
                        <column property="name"
                                header="msg://com.company.docai.view.folder/foldersColumn.header"
                                sortable="false"/>
                    </columns>
                </treeDataGrid>
            </vbox>
        </vbox>
    </content>
</fragment>
