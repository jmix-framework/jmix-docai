<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://folderDetailView.title"
      focusComponent="nameField">
    <data>
        <instance id="folderDc" class="com.company.dms.model.folder.Folder">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="folderDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose" shortcutCombination="ENTER"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="folderDc">
            <textField id="parentField" label="msg://parentField.label" readOnly="true"/>
            <textField id="nameField" property="name"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
