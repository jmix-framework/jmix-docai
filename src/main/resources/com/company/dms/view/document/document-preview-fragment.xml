<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <content>
        <vbox id="previewRoot" classNames="document-preview" width="100%">
            <vbox id="previewEmpty" classNames="document-preview-empty" width="AUTO" padding="false"
                  alignItems="CENTER">
                <icon icon="FILE" classNames="document-preview-icon"/>
                <span id="previewMessage" classNames="document-preview-message" text="msg://noDocument"/>
                <button id="downloadButton" text="msg://downloadButton.text" icon="DOWNLOAD" visible="false"/>
            </vbox>
            <image id="previewImage" classNames="document-preview-image" visible="false"/>
            <iframe id="previewFrame" classNames="document-preview-frame" visible="false"/>
            <span id="truncatedNote" classNames="document-preview-message" visible="false"/>
            <pre id="previewText" classNames="document-preview-text" visible="false"/>
        </vbox>
    </content>
</fragment>
