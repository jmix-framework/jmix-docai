<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view">
    <data>
        <instance id="revisionDc" class="com.company.dms.model.document.DocumentRevision">
            <fetchPlan extends="_base"/>
            <loader id="revisionDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="closeAction" type="view_close" text="msg:///actions.Close" icon="CLOSE"/>
    </actions>
    <layout expand="preview">
        <fragment id="preview" class="com.company.dms.view.document.DocumentPreviewFragment"/>
        <hbox id="readActions">
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
