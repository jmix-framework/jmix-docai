<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://documentDetailView.title"
      focusComponent="nameField">
    <data>
        <instance id="documentDc" class="com.company.dms.model.document.Document">
            <fetchPlan extends="_base">
                <property name="folder" fetchPlan="_base"/>
                <property name="currentRevision" fetchPlan="_base"/>
                <property name="revisions" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="documentDl"/>
            <collection id="revisionsDc" property="revisions"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <hbox id="cardHeader" classNames="document-card-header" width="100%" alignItems="CENTER" wrap="true">
            <h3 id="documentTitle"/>
            <badge id="statusBadge" dataContainer="documentDc" property="status"/>
            <span id="pendingChanges" classNames="document-card-pending"/>
            <hbox id="headerActions" classNames="document-card-actions" alignItems="CENTER" wrap="true">
                <upload id="newVersionUpload" classNames="upload-button"
                        uploadHandlerType="FILE_TEMPORARY_STORAGE" maxFiles="1"
                        dropAllowed="false" uploadText="msg://newVersionUpload.uploadText" uploadIcon="UPLOAD"/>
                <button id="downloadButton" text="msg://downloadButton.text" icon="DOWNLOAD"/>
                <button id="activateButton" text="msg://activateButton.text" icon="CHECK"/>
                <button id="archiveButton" text="msg://archiveButton.text" icon="ARCHIVE"/>
                <button id="unarchiveButton" text="msg://unarchiveButton.text" icon="UNDO"/>
            </hbox>
        </hbox>
        <tabSheet id="cardTabs" classNames="document-card-tabs" width="100%" height="100%">
            <tab id="generalTab" label="msg://generalTab.label">
                <hbox id="generalContent" width="100%" height="100%" wrap="true">
                    <formLayout id="form" classNames="document-card-form" dataContainer="documentDc">
                        <textField id="nameField" property="name"/>
                        <datePicker id="documentDateField" property="documentDate"/>
                        <textField id="folderField" label="msg://folderField.label" readOnly="true"/>
                        <textField id="currentVersionField" label="msg://currentVersionField.label" readOnly="true"/>
                        <textField id="createdField" label="msg://createdField.label" readOnly="true"/>
                        <textField id="modifiedField" label="msg://modifiedField.label" readOnly="true"/>
                    </formLayout>
                    <fragment id="preview" classNames="document-card-preview"
                              class="com.company.dms.view.document.DocumentPreviewFragment"/>
                </hbox>
            </tab>
            <tab id="versionsTab" label="msg://versionsTab.label">
                <vbox id="versionsContent" width="100%" height="100%" padding="false">
                    <hbox id="revisionActions" classNames="buttons-panel">
                        <button id="downloadRevisionButton" action="revisionsGrid.downloadRevisionAction"/>
                        <button id="showRevisionButton" action="revisionsGrid.showRevisionAction"/>
                        <button id="restoreRevisionButton" action="revisionsGrid.restoreRevisionAction"/>
                    </hbox>
                    <dataGrid id="revisionsGrid" dataContainer="revisionsDc" width="100%" height="100%">
                        <actions showInContextMenuEnabled="true">
                            <action id="downloadRevisionAction" type="list_itemTracking"
                                    text="msg://downloadRevisionAction.text" icon="DOWNLOAD"/>
                            <action id="showRevisionAction" type="list_itemTracking"
                                    text="msg://showRevisionAction.text" icon="EYE"/>
                            <action id="restoreRevisionAction" type="list_itemTracking"
                                    text="msg://restoreRevisionAction.text" icon="UNDO"/>
                        </actions>
                        <columns>
                            <column property="number" width="5rem" flexGrow="0"/>
                            <column key="fileName" header="msg://com.company.dms.model.document/DocumentRevision.file"/>
                            <column property="contentType"/>
                            <column key="size" header="msg://com.company.dms.model.document/DocumentRevision.fileSize"/>
                            <column property="createdBy"/>
                            <column property="createdDate"/>
                        </columns>
                    </dataGrid>
                </vbox>
            </tab>
        </tabSheet>
        <hbox id="detailActions">
            <button id="saveButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
