<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <data readOnly="true">
        <collection id="contentsDc" class="com.company.dms.model.trash.TrashItem"/>
    </data>
    <content>
        <vbox id="trashPreviewRoot" width="100%" height="100%" padding="false">
            <span id="placeholder" classNames="document-preview-message" text="msg://placeholder.text"/>
            <vbox id="contentsPanel" width="100%" height="100%" padding="false" visible="false" expand="contentsGrid">
                <span id="contentsSummary" classNames="document-preview-message"/>
                <dataGrid id="contentsGrid" dataContainer="contentsDc" width="100%" minHeight="8em"
                          emptyStateText="msg://contentsGrid.emptyStateText">
                    <columns resizable="true">
                        <column property="name" flexGrow="2"/>
                        <column property="location"/>
                    </columns>
                </dataGrid>
            </vbox>
            <vbox id="documentPanel" width="100%" height="100%" padding="false" visible="false"
                  expand="documentPreview">
                <button id="backButton" text="msg://backButton.text" icon="ARROW_LEFT" themeNames="tertiary"/>
                <fragment id="documentPreview" class="com.company.dms.view.document.DocumentPreviewFragment"/>
            </vbox>
        </vbox>
    </content>
</fragment>
