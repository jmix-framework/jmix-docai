<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://repositoryView.title">
    <facets>
        <urlQueryParameters id="urlQueryParameters"/>
        <settings auto="true"/>
    </facets>
    <layout>
        <sidePanelLayout id="previewLayout" classNames="repository-preview-layout" width="100%" height="100%"
                         sidePanelPosition="RIGHT" sidePanelOverlay="false" modal="false"
                         closeOnOutsideClick="false" sidePanelResizable="true" themeNames="resizer-small"
                         sidePanelHorizontalSize="40%" sidePanelHorizontalMinSize="20em">
            <split id="split" classNames="repository-split" width="100%" height="100%" splitterPosition="20"
                   themeNames="splitter-spacing">
                <fragment id="folderTree" class="com.company.dms.view.repository.FolderTreeFragment"/>
                <vbox id="documentPane" classNames="repository-documents" width="100%" height="100%" padding="false">
                    <hbox id="breadcrumbs" classNames="breadcrumbs" width="100%" alignItems="BASELINE"
                          spacing="false" wrap="true"/>
                    <fragment id="documentList" classNames="repository-document-list"
                              class="com.company.dms.view.repository.DocumentListFragment"/>
                </vbox>
            </split>
            <vbox id="previewPanel" classNames="repository-preview-panel" width="100%" height="100%" expand="preview">
                <hbox id="previewHeader" width="100%" alignItems="CENTER">
                    <h4 id="previewTitle" text="msg://previewTitle.text" width="100%"/>
                    <sidePanelLayoutCloser id="previewCloser" sidePanelLayoutId="previewLayout"/>
                </hbox>
                <fragment id="preview" classNames="repository-preview"
                          class="com.company.dms.view.document.DocumentPreviewFragment"/>
            </vbox>
        </sidePanelLayout>
    </layout>
</view>
