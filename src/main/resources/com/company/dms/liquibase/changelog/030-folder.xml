<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="com/company/dms/liquibase/changelog/030-folder.xml">

    <changeSet id="1" author="jmix-dms" context="!cuba">
        <createTable tableName="FOLDER">
            <column name="ID" type="${uuid.type}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_FOLDER"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="PARENT_ID" type="${uuid.type}"/>
            <column name="NAME_KEY" type="varchar(255)"/>
            <column name="CREATED_BY" type="varchar(255)"/>
            <column name="CREATED_DATE" type="timestamp with time zone"/>
            <column name="LAST_MODIFIED_BY" type="varchar(255)"/>
            <column name="LAST_MODIFIED_DATE" type="timestamp with time zone"/>
            <column name="DELETED_BY" type="varchar(255)"/>
            <column name="DELETED_DATE" type="timestamp with time zone"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="jmix-dms" context="!cuba">
        <createIndex indexName="IDX_FOLDER_PARENT" tableName="FOLDER">
            <column name="PARENT_ID"/>
        </createIndex>
        <createIndex indexName="UK_FOLDER_NAME_KEY" tableName="FOLDER" unique="true">
            <column name="PARENT_ID"/>
            <column name="NAME_KEY"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="FOLDER" baseColumnNames="PARENT_ID"
                                 referencedTableName="FOLDER" referencedColumnNames="ID"
                                 constraintName="FK_FOLDER_ON_PARENT"/>
    </changeSet>

    <changeSet id="3" author="jmix-dms" context="!cuba">
        <insert tableName="FOLDER" dbms="postgresql, mssql, hsqldb, h2">
            <column name="ID" value="1a6e3c0e-5b0f-4c55-9a3e-6f1d2c7b8e01"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="NAME" value="Repository"/>
            <column name="NAME_KEY" value="Repository"/>
        </insert>
        <insert tableName="FOLDER" dbms="oracle, mysql, mariadb">
            <column name="ID" value="1a6e3c0e5b0f4c559a3e6f1d2c7b8e01"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="NAME" value="Repository"/>
            <column name="NAME_KEY" value="Repository"/>
        </insert>
    </changeSet>

</databaseChangeLog>
