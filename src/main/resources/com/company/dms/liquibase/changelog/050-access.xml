<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        logicalFilePath="com/company/dms/liquibase/changelog/050-access.xml">

    <changeSet id="1" author="jmix-dms" context="!cuba">
        <createTable tableName="ACCESS_SET">
            <column name="ID" type="${uuid.type}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_SET"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="OWNER_FOLDER_ID" type="${uuid.type}"/>
            <column name="OWNER_DOCUMENT_ID" type="${uuid.type}"/>
        </createTable>

        <createTable tableName="ACCESS_ENTRY">
            <column name="ID" type="${uuid.type}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ACCESS_ENTRY"/>
            </column>
            <column name="VERSION" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="ACCESS_SET_ID" type="${uuid.type}">
                <constraints nullable="false"/>
            </column>
            <column name="USERNAME" type="varchar(255)"/>
            <column name="ROLE_CODE" type="varchar(255)"/>
            <column name="ACCESS_LEVEL" type="int">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addColumn tableName="FOLDER">
            <column name="ACCESS_SET_ID" type="${uuid.type}"/>
        </addColumn>

        <addColumn tableName="DOCUMENT">
            <column name="ACCESS_SET_ID" type="${uuid.type}"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" author="jmix-dms" context="!cuba" dbms="postgresql, mssql, hsqldb, h2">
        <insert tableName="ACCESS_SET">
            <column name="ID" value="2bf6f55e-0ad3-4afc-94bc-1a0915e3c932"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="OWNER_FOLDER_ID" value="1a6e3c0e-5b0f-4c55-9a3e-6f1d2c7b8e01"/>
        </insert>
        <insert tableName="ACCESS_ENTRY">
            <column name="ID" value="a1d48058-1ecd-4a73-9935-646483b77903"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="ACCESS_SET_ID" value="2bf6f55e-0ad3-4afc-94bc-1a0915e3c932"/>
            <column name="ROLE_CODE" value="employee"/>
            <column name="ACCESS_LEVEL" valueNumeric="20"/>
        </insert>
        <update tableName="FOLDER">
            <column name="ACCESS_SET_ID" value="2bf6f55e-0ad3-4afc-94bc-1a0915e3c932"/>
            <where>ID = '1a6e3c0e-5b0f-4c55-9a3e-6f1d2c7b8e01'</where>
        </update>
    </changeSet>

    <changeSet id="3" author="jmix-dms" context="!cuba" dbms="oracle, mysql, mariadb">
        <insert tableName="ACCESS_SET">
            <column name="ID" value="2bf6f55e0ad34afc94bc1a0915e3c932"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="OWNER_FOLDER_ID" value="1a6e3c0e5b0f4c559a3e6f1d2c7b8e01"/>
        </insert>
        <insert tableName="ACCESS_ENTRY">
            <column name="ID" value="a1d480581ecd4a739935646483b77903"/>
            <column name="VERSION" valueNumeric="1"/>
            <column name="ACCESS_SET_ID" value="2bf6f55e0ad34afc94bc1a0915e3c932"/>
            <column name="ROLE_CODE" value="employee"/>
            <column name="ACCESS_LEVEL" valueNumeric="20"/>
        </insert>
        <update tableName="FOLDER">
            <column name="ACCESS_SET_ID" value="2bf6f55e0ad34afc94bc1a0915e3c932"/>
            <where>ID = '1a6e3c0e5b0f4c559a3e6f1d2c7b8e01'</where>
        </update>
    </changeSet>

    <changeSet id="4" author="jmix-dms" context="!cuba">
        <addNotNullConstraint tableName="FOLDER" columnName="ACCESS_SET_ID" columnDataType="${uuid.type}"/>
        <addNotNullConstraint tableName="DOCUMENT" columnName="ACCESS_SET_ID" columnDataType="${uuid.type}"/>

        <addUniqueConstraint tableName="ACCESS_SET" columnNames="OWNER_FOLDER_ID"
                             constraintName="UK_ACCESS_SET_OWNER_FOLDER"/>
        <addUniqueConstraint tableName="ACCESS_SET" columnNames="OWNER_DOCUMENT_ID"
                             constraintName="UK_ACCESS_SET_OWNER_DOCUMENT"/>
        <addForeignKeyConstraint baseTableName="ACCESS_SET" baseColumnNames="OWNER_FOLDER_ID"
                                 referencedTableName="FOLDER" referencedColumnNames="ID"
                                 constraintName="FK_ACCESS_SET_ON_OWNER_FOLDER"/>
        <addForeignKeyConstraint baseTableName="ACCESS_SET" baseColumnNames="OWNER_DOCUMENT_ID"
                                 referencedTableName="DOCUMENT" referencedColumnNames="ID"
                                 constraintName="FK_ACCESS_SET_ON_OWNER_DOCUMENT"/>

        <createIndex indexName="IDX_ACCESS_ENTRY_ACCESS_SET" tableName="ACCESS_ENTRY">
            <column name="ACCESS_SET_ID"/>
        </createIndex>
        <addUniqueConstraint tableName="ACCESS_ENTRY" columnNames="ACCESS_SET_ID, USERNAME"
                             constraintName="UK_ACCESS_ENTRY_USER"/>
        <addUniqueConstraint tableName="ACCESS_ENTRY" columnNames="ACCESS_SET_ID, ROLE_CODE"
                             constraintName="UK_ACCESS_ENTRY_ROLE"/>
        <addForeignKeyConstraint baseTableName="ACCESS_ENTRY" baseColumnNames="ACCESS_SET_ID"
                                 referencedTableName="ACCESS_SET" referencedColumnNames="ID"
                                 constraintName="FK_ACCESS_ENTRY_ON_ACCESS_SET" onDelete="CASCADE"/>

        <createIndex indexName="IDX_FOLDER_ACCESS_SET" tableName="FOLDER">
            <column name="ACCESS_SET_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="FOLDER" baseColumnNames="ACCESS_SET_ID"
                                 referencedTableName="ACCESS_SET" referencedColumnNames="ID"
                                 constraintName="FK_FOLDER_ON_ACCESS_SET"/>

        <createIndex indexName="IDX_DOCUMENT_ACCESS_SET" tableName="DOCUMENT">
            <column name="ACCESS_SET_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="DOCUMENT" baseColumnNames="ACCESS_SET_ID"
                                 referencedTableName="ACCESS_SET" referencedColumnNames="ID"
                                 constraintName="FK_DOCUMENT_ON_ACCESS_SET"/>
    </changeSet>

</databaseChangeLog>
